{
  "schemaVersion": 1,
  "id": "safeinteract",
  "version": "${version}",
  "name": "SafeInteract",
  "description": "Client-side safeguards for building, tools, and interactions.",
  "authors": ["winax1337"],
  "license": "MIT",
  "contact": {
    "homepage": "https://github.com/Winaxdev/SafeInteract",
    "sources": "https://github.com/Winaxdev/SafeInteract",
    "issues": "https://github.com/Winaxdev/SafeInteract/issues"
  },
  "icon": "assets/safeinteract/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.safeinteract.SafeInteractClient"],
    "modmenu": ["com.safeinteract.config.ModMenuIntegration"]
  },
  "mixins": [{"config": "safeinteract.mixins.json", "environment": "client"}],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config": "*"
  }
}
